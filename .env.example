# Safe local default. Activation means changing this to BOT_ENABLED=true only
# after the real identity/credentials exist and a live test is explicitly approved.
BOT_ENABLED=false
BOT_DID=
BOT_HANDLE=
BOT_PDS_URL=

# Direct AppView and poller behavior are fixed in the POC implementation:
# https://api.bsky.app, one poll every 30 seconds, five pages maximum.
OPERATOR_ALLOWED_DIDS=
THREAD_PARENT_HEIGHT=80
ACTOR_HOURLY_LIMIT=2
ACTOR_DAILY_LIMIT=5
GLOBAL_HOURLY_LIMIT=10
GLOBAL_DAILY_LIMIT=50
MAX_PENDING=25
QUEUE_CONCURRENCY=1

ANTHROPIC_MODEL_ID=claude-sonnet-5
ANTHROPIC_RESEARCH_MAX_TOKENS=8192
ANTHROPIC_LENGTH_REPAIR_MAX_TOKENS=1024
MAX_WEB_SEARCH_USES=5
MAX_WEB_FETCH_USES=5
MAX_WEB_FETCH_CONTENT_TOKENS=50000
MAX_TOOL_CONTINUATIONS=3
ANTHROPIC_MAX_HTTP_RETRIES=2
ANTHROPIC_RETRY_BASE_MS=1000
ANTHROPIC_RETRY_MAX_MS=30000
ANTHROPIC_RESPONSE_MAX_BYTES=8000000
PROVIDER_RESPONSE_STORAGE_MAX_BYTES=64000000
ANTHROPIC_DAILY_BUDGET_USD=20.000000
ANTHROPIC_RESEARCH_RESERVATION_USD=5.000000
ANTHROPIC_CONTINUATION_RESERVATION_USD=5.000000
ANTHROPIC_REPAIR_RESERVATION_USD=5.000000
ANTHROPIC_RETRY_RESERVATION_USD=5.000000
ANTHROPIC_PRICING_VERSION=sonnet-5-2026-07-28

# For live local operation, load these from secrets.sh after setting
# BITWARDEN_ITEM_ID. Do not put real values in this file or commit .env.
BITWARDEN_ITEM_ID=
BOT_APP_PASSWORD=
ANTHROPIC_API_KEY=
