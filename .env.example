# Safe local default. Activation means changing this to BOT_ENABLED=true only
# after the real identity/credentials exist and a live test is explicitly approved.
BOT_ENABLED=false
BOT_DID=
BOT_HANDLE=
BOT_PDS_URL=

# Leave empty for JSONL logs on stderr, or set an absolute append-only file path.
CONTEXT_BOT_LOG_PATH=

# Dedicated durable state for `just live-run`; this must not be the development,
# test, or production database.
CONTEXT_BOT_LIVE_DATABASE_PATH=data/live-demo.db

# External service locations, polling bounds, and request timeouts. Startup
# validates every value and fails closed on malformed input.
# Reviewed trust root; alternate origins require a design change.
APPVIEW_URL=https://api.bsky.app
# Valid interval: 5000..3600000. Valid page cap: 1..20. ATProto and
# thread timeouts are capped at 60000 ms.
POLL_INTERVAL_MS=30000
NOTIFICATION_PAGE_CAP=5
ATPROTO_HTTP_TIMEOUT_MS=15000
ATPROTO_SESSION_TIMEOUT_MS=15000
THREAD_FETCH_TIMEOUT_MS=20000
OPERATOR_ALLOWED_DIDS=
THREAD_PARENT_HEIGHT=80
# Hourly burst cap for non-operator actors. Daily tiers are the actor cap.
ACTOR_HOURLY_LIMIT=2
# Privileged daily limit for confirmed elders and verified bsky.team actors.
ACTOR_DAILY_LIMIT=5
# Public daily limit for everyone else. Labeler/identity outages use this tier.
ACTOR_DAILY_LIMIT_PUBLIC=1
GLOBAL_HOURLY_LIMIT=10
GLOBAL_DAILY_LIMIT=50
MAX_PENDING=25
QUEUE_CONCURRENCY=1

# Anthropic timeout is capped at 600000 ms. Output, web-tool, continuation,
# retry, response, and storage caps are validated together at startup.
# QUEUE_CONCURRENCY must remain exactly 1 for serial provider execution.
ANTHROPIC_MODEL_ID=claude-sonnet-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_HTTP_TIMEOUT_MS=300000
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_WEB_SEARCH_TOOL_TYPE=web_search_20260318
ANTHROPIC_WEB_FETCH_TOOL_TYPE=web_fetch_20260318
ANTHROPIC_RESEARCH_MAX_TOKENS=4096
ANTHROPIC_LENGTH_REPAIR_MAX_TOKENS=1024
MAX_WEB_SEARCH_USES=5
MAX_WEB_FETCH_USES=2
MAX_WEB_FETCH_CONTENT_TOKENS=10000
MAX_TOOL_CONTINUATIONS=1
ANTHROPIC_MAX_HTTP_RETRIES=2
ANTHROPIC_RETRY_BASE_MS=1000
ANTHROPIC_RETRY_MAX_MS=30000
ANTHROPIC_RESPONSE_MAX_BYTES=8000000
PROVIDER_RESPONSE_STORAGE_MAX_BYTES=64000000
ANTHROPIC_DAILY_BUDGET_USD=20.000000
ANTHROPIC_RESEARCH_RESERVATION_USD=5.000000
ANTHROPIC_CONTINUATION_RESERVATION_USD=5.000000
ANTHROPIC_REPAIR_RESERVATION_USD=5.000000
ANTHROPIC_RETRY_RESERVATION_USD=5.000000
ANTHROPIC_PRICING_VERSION=sonnet-5-2026-07-28

# For live local operation, load these from secrets.sh after setting
# BITWARDEN_ITEM_ID. `just dry-run` requests only ANTHROPIC_API_KEY;
# `just live-run` requests BOT_APP_PASSWORD and ANTHROPIC_API_KEY; deploy requests
# all allowlisted fields. Do not put real values here or commit .env.
BITWARDEN_ITEM_ID=
BOT_APP_PASSWORD=
ANTHROPIC_API_KEY=
